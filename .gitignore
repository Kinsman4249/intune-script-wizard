# Runtime state - contains snapshots of deployed script content, keep local only.
backups/
# Exported tenant templates - holds tenant script content and group display
# names (same reason as backups/ above), and becomes its own git repo once
# template pushing is configured, so a nested repo tracked by the outer one
# would fight it for the same files (see lib/RepoBackup.ps1's Sync-WizardRepoBackupDir).
templates/
.intune-script-cache.json
logs/
.repo-sources/

# Session notes (see CLAUDE.md workflow)
handoff.md
todo.md

# E2E test kit - tenant-specific group data and generated build output.
e2e-tests/e2e-metadata.json
e2e-tests/generated/
